# Ignore the HELP file
backend/HELP.md

# Ignore the target directory (root and all nested)
target/

# Maven wrapper - include only the wrapper JAR file
backend/.mvn/
!backend/.mvn/wrapper/maven-wrapper.jar

# Spring Tool Suite specific files
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA specific files
.idea/
*.iws
*.iml
*.ipr

# NetBeans specific files
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Build directories
build/
.next/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variable files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS-specific files
.DS_Store
Thumbs.db

# Node.js modules
node_modules/

# IDE files
.vscode/

# Test coverage reports
coverage/

# Temporary and backup files
*.log
*.tmp
*.swp

# Package lock files (optional, if not required for deployment consistency)
package-lock.json
yarn.lock
pnpm-lock.yaml
